# Create a timestamped temporary reframe branch from the primary branch.
#
# Arguments:
#   $1: Final branch root to target later.
#   $2: Optional source branch name. Defaults to the current branch.
# Returns:
#   0 when the temporary branch is created and checked out, otherwise non-zero.
# Side effects:
#   Fetches origin, switches branches, creates a branch, merges the source branch,
#   and writes branch-local git config metadata.
greframe-start() {
  local final_branch
  local source_branch
  local current_branch
  local base_branch
  local temp_branch

  if [[ $# -lt 1 || $# -gt 2 ]]; then
    print -u2 -- 'usage: greframe-start <final-branch> [source-branch]'
    return 1
  fi

  final_branch=$1
  source_branch=${2:-$(command git branch --show-current 2>/dev/null)}

  git-reframe-require-repo || return 1
  git-reframe-require-clean-worktree || return 1
  [[ -n "${source_branch}" ]] || git-reframe-fail 'unable to determine the source branch' || return 1
  git-reframe-require-local-branch "${source_branch}" || return 1

  base_branch="$(git-reframe-primary-branch)" || return 1
  [[ "${source_branch}" != "${base_branch}" ]] || git-reframe-fail 'source branch matches the primary branch; no reframe is needed' || return 1

  git-reframe-require-available-branch "${final_branch}" || return 1
  temp_branch="$(git-reframe-temp-branch-name "${final_branch}")"
  git-reframe-require-available-branch "${temp_branch}" || return 1

  current_branch="$(command git branch --show-current 2>/dev/null)"
  git-reframe-sync-base-branch "${base_branch}" || return 1
  command git switch -c "${temp_branch}" || return 1
  command git merge --no-ff --no-edit "${source_branch}" || return 1
  git-reframe-store-metadata "${temp_branch}" "${source_branch}" "${base_branch}" "${final_branch}"

  git-reframe-summary-line source "${source_branch}"
  git-reframe-summary-line previous "${current_branch:-${source_branch}}"
  git-reframe-summary-line base "${base_branch}"
  git-reframe-summary-line temp "${temp_branch}"
  git-reframe-summary-line final "${final_branch}"
  print -r -- 'greframe next: continue working on the temp branch until you are ready to finish'
}
