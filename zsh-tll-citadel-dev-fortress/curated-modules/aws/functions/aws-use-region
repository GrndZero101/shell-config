# Set the active AWS region for the current shell.
#
# Arguments:
#   $1 - Region name.
# Returns:
#   0 on success, non-zero on missing input.
# Side effects:
#   Exports AWS_REGION and AWS_DEFAULT_REGION in the current shell.
aws-use-region() {
  local region_name="${1:-}"

  [[ -n "${region_name}" ]] || {
    print -u2 -- 'usage: aws-use-region <region>'
    return 1
  }

  export AWS_REGION="${region_name}"
  export AWS_DEFAULT_REGION="${region_name}"
  print -r -- "AWS_REGION=${AWS_REGION}"
}
