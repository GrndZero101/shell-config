# Set the active AWS profile for the current shell.
#
# Arguments:
#   $1 - Profile name.
# Returns:
#   0 on success, non-zero on missing input.
# Side effects:
#   Exports AWS_PROFILE and AWS_DEFAULT_PROFILE in the current shell.
aws-use-profile() {
  local profile_name="${1:-}"

  [[ -n "${profile_name}" ]] || {
    print -u2 -- 'usage: aws-use-profile <profile>'
    return 1
  }

  export AWS_PROFILE="${profile_name}"
  export AWS_DEFAULT_PROFILE="${profile_name}"
  print -r -- "AWS_PROFILE=${AWS_PROFILE}"
}
