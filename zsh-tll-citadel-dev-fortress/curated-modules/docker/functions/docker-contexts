# Print Docker contexts in a compact table.
#
# Arguments:
#   None.
# Returns:
#   0 on success, non-zero when Docker is unavailable or the command fails.
# Side effects:
#   Calls the Docker CLI.
docker-contexts() {
  docker context ls --format 'table {{.Current}}\t{{.Name}}\t{{.Description}}\t{{.DockerEndpoint}}'
}
