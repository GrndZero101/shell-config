# Switch the active Docker context.
#
# Arguments:
#   $1 - Context name.
# Returns:
#   0 on success, non-zero on missing input or Docker failure.
# Side effects:
#   Calls the Docker CLI and changes the active Docker context.
docker-use-context() {
  local context_name="${1:-}"

  [[ -n "${context_name}" ]] || {
    print -u2 -- 'usage: docker-use-context <context>'
    return 1
  }

  docker context use "${context_name}"
}
