# Set the active kubectl namespace for the current context.
#
# Arguments:
#   $1 - Namespace name.
# Returns:
#   0 on success, non-zero on missing input or kubectl failure.
# Side effects:
#   Calls kubectl config set-context.
kubectl-use-namespace() {
  local namespace_name="${1:-}"

  [[ -n "${namespace_name}" ]] || {
    print -u2 -- 'usage: kubectl-use-namespace <namespace>'
    return 1
  }

  kubectl config set-context --current --namespace "${namespace_name}"
}
