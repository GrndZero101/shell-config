# Remove the Homebrew description comment directly above one Brewfile entry.
#
# `brew bundle remove` deletes an entry but leaves the `# description` line
# that dump and add write above it. To avoid touching hand-written comments,
# the exact comment Homebrew would write is generated by adding the entry to
# a scratch Brewfile, and a line is removed only when it equals that comment
# and sits immediately above the matching entry.
#
# Arguments:
#   $1 - Brewfile path.
#   $2 - Entry kind: brew or cask.
#   $3 - Package name.
# Returns:
#   0 always; a missing description or no adjacent match leaves the file as is.
# Side effects:
#   Rewrites the Brewfile in place (`>|`) so a symlinked Brewfile stays a symlink.
brew-drop-description() {
  emulate -L zsh

  local bf="$1" kind="$2" name="$3"
  local scratch comment i
  local -a add_flags lines

  [[ "${kind}" == 'cask' ]] && add_flags=(--cask)

  scratch="$(mktemp "${TMPDIR:-/tmp}/brew-drop-description.XXXXXX")" || return 0
  brew bundle add --file="${scratch}" "${add_flags[@]}" -- "${name}" >/dev/null 2>&1
  comment="$(<"${scratch}")"
  rm -f -- "${scratch}"
  comment="${${(f)comment}[1]}"
  [[ "${comment}" == '# '* ]] || return 0

  lines=("${(@f)$(<"${bf}")}")
  for (( i = 2; i <= ${#lines}; i++ )); do
    # The entry match treats the name literally and allows options or a trailing comment.
    if [[ "${lines[i-1]}" == "${comment}" && "${lines[i]}" == "${kind} \"${name}\""(|[,[:space:]]*) ]]; then
      lines[i-1]=()
      print -rl -- "${lines[@]}" >| "${bf}"
      return 0
    fi
  done
}
