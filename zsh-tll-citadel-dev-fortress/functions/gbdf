#autoload

emulate -L zsh

local branch current_branch
local -a selected_branches

current_branch="$(git-current-branch)" || return 1
selected_branches=(${(f)"$(
  command git for-each-ref --format='%(refname:short)' refs/heads \
    | grep -v "^${current_branch}$" \
    | fzf --multi --height=50% --layout=reverse --border --prompt='delete-branch> '
)"}) || return 1

for branch in "${selected_branches[@]}"; do
  command git branch -d -- "${branch}"
done
