#autoload

emulate -L zsh

local branch selected_branch

selected_branch="$(
  command git for-each-ref \
    --sort=-committerdate \
    --format='%(refname:short)' \
    refs/heads refs/remotes \
    | awk '!seen[$0]++' \
    | fzf --height=50% --layout=reverse --border --prompt='branch> '
)" || return 1

branch="${selected_branch#origin/}"
command git checkout -- "${branch}"
