#autoload

emulate -L zsh

local ahead behind
local -a counts

SHELL_GIT_PROMPT_EXTRA=''
command git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0

counts=(${(s: :)$(command git rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null)})
if (( ${#counts} == 2 )); then
  behind="${counts[1]}"
  ahead="${counts[2]}"

  if [[ "${ahead}" != '0' || "${behind}" != '0' ]]; then
    SHELL_GIT_PROMPT_EXTRA=" %F{245}[+${ahead}|-${behind}]%f"
  fi
fi
