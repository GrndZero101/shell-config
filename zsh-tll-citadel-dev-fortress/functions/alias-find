# Search the live alias table by alias name or expansion text.
#
# Arguments:
#   <query>        - case-insensitive text to match.
#   -i, --interactive - open a picker over the matching aliases.
# Returns:
#   0 on success, non-zero on invalid usage, no matches, or cancelled selection.
# Side effects:
#   Reads the live alias table and may invoke fzf or a native select prompt.
alias-find() {
  emulate -L zsh
  setopt localoptions no_aliases

  local interactive_mode=0
  local query_text=''
  local current_line alias_name alias_value alias_source selected_line
  local header_alias='alias'
  local header_source='source'
  integer max_alias_width=5
  integer max_source_width=6
  local -a all_alias_names matched_records matched_names

  while (( $# > 0 )); do
    case "${1}" in
      -i|--interactive)
        interactive_mode=1
        ;;
      --*)
        print -u2 -- "usage: alias-find [-i|--interactive] <query>"
        return 1
        ;;
      *)
        if [[ -n "${query_text}" ]]; then
          query_text+=" "
        fi
        query_text+="${1}"
        ;;
    esac
    shift
  done

  if [[ -z "${query_text}" ]]; then
    if (( interactive_mode )); then
      alias-list -i
      return $?
    fi

    print -u2 -- 'usage: alias-find [-i|--interactive] <query>'
    return 1
  fi

  all_alias_names=(${(ok)aliases})
  for alias_name in "${all_alias_names[@]}"; do
    alias_value="${aliases[${alias_name}]}"
    alias_source="${SHELL_FORTRESS_ALIAS_SOURCES[${alias_name}]-unknown}"
    if [[ "${alias_name:l}" == *"${query_text:l}"* || "${alias_value:l}" == *"${query_text:l}"* ]]; then
      (( ${#alias_name} > max_alias_width )) && max_alias_width=${#alias_name}
      (( ${#alias_source} > max_source_width )) && max_source_width=${#alias_source}
      matched_records+=("${alias_name}"$'\t'"${alias_source}"$'\t'"${alias_value}")
      matched_names+=("${alias_name}")
    fi
  done

  if (( ${#matched_records[@]} == 0 )); then
    print -u2 -- "alias-find: no aliases matched '${query_text}'"
    return 1
  fi

  if (( interactive_mode )); then
    if (( $+commands[fzf] )); then
      selected_line="$(
        printf '%s\n' "${matched_records[@]}" | fzf \
          --ansi \
          --border \
          --height=60% \
          --layout=reverse \
          --delimiter=$'\t' \
          --with-nth=1,2,3 \
          --prompt='alias-find> ' \
          --header="󰌌 matches for: ${query_text}" \
          --preview='printf "alias: %s\nsource: %s\nexpansion: %s\n" {1} {2} {3}'
      )" || return 1
    else
      local selected_name
      if [[ ! -t 0 ]]; then
        print -u2 -- 'alias-find: interactive mode requires a terminal'
        return 1
      fi

      print -P -- "%F{221}fzf not found; using zsh select menu.%f"
      select selected_name in "${matched_names[@]}"; do
        [[ -n "${selected_name}" ]] || {
          print -u2 -- 'Invalid selection.'
          continue
        }
        selected_line="${selected_name}"$'\t'"${SHELL_FORTRESS_ALIAS_SOURCES[${selected_name}]-unknown}"$'\t'"${aliases[${selected_name}]}"
        break
      done
    fi

    [[ -n "${selected_line}" ]] || return 1
    alias_name="${selected_line%%$'\t'*}"
    selected_line="${selected_line#*$'\t'}"
    alias_source="${selected_line%%$'\t'*}"
    alias_value="${selected_line#*$'\t'}"
    print -P -- "%F{81}%Balias%b%f     ${alias_name}"
    print -P -- "%F{110}source:%f    ${alias_source}"
    print -P -- "%F{110}expands:%f   ${alias_value}"
    return 0
  fi

  print -P -- "%F{81}%B󰌌 Alias Matches%b%f %F{244}${query_text}%f"
  print -P -- "%F{244}${(r:${max_alias_width}:)header_alias} ${(r:${max_source_width}:)header_source} expansion%f"
  for current_line in "${matched_records[@]}"; do
    alias_name="${current_line%%$'\t'*}"
    current_line="${current_line#*$'\t'}"
    alias_source="${current_line%%$'\t'*}"
    alias_value="${current_line#*$'\t'}"
    print -r -- "${(r:${max_alias_width}:)alias_name} ${(r:${max_source_width}:)alias_source} ${alias_value}"
  done
}
