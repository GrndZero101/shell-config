# Launch the interactive csm profile selector from zle.
#
# Arguments:
#   None.
# Returns:
#   0 after queuing the selector command, non-zero when the current buffer is not empty.
# Side effects:
#   Executes `csm select -i` through the active command line.
fortress-csm-select-widget() {
  emulate -L zsh

  fortress-zle-run-command 'csm select -i'
}
