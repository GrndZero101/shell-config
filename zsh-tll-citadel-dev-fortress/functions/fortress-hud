#autoload

# Print a fortress runtime HUD in standard or pretty mode.

emulate -L zsh

# Print one standard-mode section line.
# Arguments:
#   $1: section name.
#   $2: key name.
#   $3: value text.
# Returns:
#   0 after printing the line.
# Side effects:
#   Writes a stable sectioned key/value line to stdout.
fortress-hud-print-standard-line() {
  local section_name="$1"
  local key_name="$2"
  local value_text="$3"

  print -r -- "[${section_name}] ${key_name}: ${value_text}"
}

# Print one pretty-mode section heading.
# Arguments:
#   $1: icon.
#   $2: title.
# Returns:
#   0 after printing the heading.
# Side effects:
#   Writes a Catppuccin-tinted heading to stdout.
fortress-hud-print-pretty-heading() {
  local icon="$1"
  local title="$2"

  print -P -- "%F{111}%B${icon} ${title}%b%f"
}

# Print one pretty-mode key/value line.
# Arguments:
#   $1: key label.
#   $2: value text.
# Returns:
#   0 after printing the line.
# Side effects:
#   Writes a colorized key/value line to stdout.
fortress-hud-print-pretty-line() {
  local key_name="$1"
  local value_text="$2"

  print -P -- "  %F{110}${key_name}:%f ${value_text}"
}

# Format a boolean state label for the selected renderer.
# Arguments:
#   $1: renderer mode, standard or pretty.
#   $2: numeric truth value.
# Returns:
#   0 after printing the rendered state.
# Side effects:
#   Writes formatted text to stdout.
fortress-hud-render-bool() {
  local render_mode="$1"
  local bool_value="$2"

  if [[ "${render_mode}" == 'pretty' ]]; then
    if (( bool_value )); then
      print -P -- "%F{114}on%f"
    else
      print -P -- "%F{203}off%f"
    fi
    return 0
  fi

  if (( bool_value )); then
    print -r -- 'on'
  else
    print -r -- 'off'
  fi
}

# Render a command availability state for the selected renderer.
# Arguments:
#   $1: renderer mode, standard or pretty.
#   $2: command name.
# Returns:
#   0 after printing the rendered availability text.
# Side effects:
#   Writes formatted text to stdout.
fortress-hud-render-command() {
  local render_mode="$1"
  local command_name="$2"

  if (( $+commands[${command_name}] )); then
    if [[ "${render_mode}" == 'pretty' ]]; then
      print -P -- "%F{114}available%f (${commands[${command_name}]})"
    else
      print -r -- "available (${commands[${command_name}]})"
    fi
    return 0
  fi

  if [[ "${render_mode}" == 'pretty' ]]; then
    print -P -- '%F{203}missing%f'
  else
    print -r -- 'missing'
  fi
}

# Print the recorded or derived active source for one enabled module.
# Arguments:
#   $1: module name.
# Returns:
#   0 after printing the source label.
fortress-hud-module-active-source() {
  local module_name="$1"
  local local_path="${SHELL_FORTRESS_MODULE_LOCAL_PATHS[${module_name}]-${SHELL_FORTRESS_MODULES_DIR:-}/${module_name}.zsh}"
  local curated_path="${SHELL_FORTRESS_MODULE_CURATED_PATHS[${module_name}]-${ZDOTDIR:-}/curated-modules/${module_name}/module.zsh}"

  if [[ -n "${SHELL_FORTRESS_MODULE_ACTIVE_SOURCES[${module_name}]-}" ]]; then
    print -r -- "${SHELL_FORTRESS_MODULE_ACTIVE_SOURCES[${module_name}]}"
    return 0
  fi

  if [[ -r "${local_path}" ]]; then
    if [[ -r "${curated_path}" ]]; then
      print -r -- 'local-fork'
    else
      print -r -- 'local-only'
    fi
    return 0
  fi

  if [[ -r "${curated_path}" ]]; then
    print -r -- 'curated'
    return 0
  fi

  print -r -- 'missing'
}

# Print the requires metadata from the active module file header.
# Arguments:
#   $1: module name.
# Returns:
#   0 after printing the space-separated requirement names, or nothing when
#   the module has no active file or no requires header.
# Side effects:
#   Reads the leading comment block of the active module file.
fortress-hud-module-requires() {
  local module_path="${SHELL_FORTRESS_MODULE_ACTIVE_PATHS[$1]-}"
  local header_line requires_value

  [[ -r "${module_path}" ]] || return 0

  while IFS= read -r header_line; do
    [[ "${header_line}" == '# '* ]] || break
    if [[ "${header_line}" == '# requires:'* ]]; then
      requires_value="${header_line#'# requires:'}"
      print -r -- ${=requires_value//,/ }
      return 0
    fi
  done < "${module_path}"
}

# Print the startup load status for one enabled module.
# A module that sourced cleanly but added no functions or aliases while a
# required command is absent is reported as skipped, because curated modules
# guard themselves with `(( $+commands[tool] )) || return 0`.
# Arguments:
#   $1: module name.
# Returns:
#   0 after printing loaded, skipped(missing:<cmds>), failed:<code>, missing,
#   or unknown when startup recorded nothing.
fortress-hud-module-status() {
  local module_name="$1"
  local load_status="${SHELL_FORTRESS_MODULE_LOAD_STATUS[${module_name}]-unknown}"
  local required_name
  local -a missing_commands

  if [[ "${load_status}" == 'loaded' ]] \
    && (( ${SHELL_FORTRESS_MODULE_ADDED_FUNCTIONS[${module_name}]:-0} + ${SHELL_FORTRESS_MODULE_ADDED_ALIASES[${module_name}]:-0} == 0 )); then
    for required_name in ${=$(fortress-hud-module-requires "${module_name}")}; do
      (( $+commands[${required_name}] )) || missing_commands+=("${required_name}")
    done
    if (( ${#missing_commands} )); then
      load_status="skipped(missing:${(j:,:)missing_commands})"
    fi
  fi

  print -r -- "${load_status}"
}

# Print one compact module-resolution summary line.
# Arguments:
#   $1: module name.
# Returns:
#   0 after printing the summary text: source and shadowing state, then load
#   status, load time, functions and aliases added, and declared requirements.
fortress-hud-module-summary() {
  local module_name="$1"
  local active_source local_path curated_path shadow_state requires_text

  active_source="$(fortress-hud-module-active-source "${module_name}")"
  local_path="${SHELL_FORTRESS_MODULE_LOCAL_PATHS[${module_name}]-${SHELL_FORTRESS_MODULES_DIR:-}/${module_name}.zsh}"
  curated_path="${SHELL_FORTRESS_MODULE_CURATED_PATHS[${module_name}]-${ZDOTDIR:-}/curated-modules/${module_name}/module.zsh}"
  shadow_state='no'
  requires_text="$(fortress-hud-module-requires "${module_name}")"

  if [[ "${active_source}" == 'local-fork' ]]; then
    shadow_state='curated'
  fi

  print -r -- "active=${active_source} shadowing=${shadow_state} local=$([[ -r "${local_path}" ]] && print -r -- present || print -r -- absent) curated=$([[ -r "${curated_path}" ]] && print -r -- present || print -r -- absent) status=$(fortress-hud-module-status "${module_name}") load=${SHELL_FORTRESS_MODULE_LOAD_MS[${module_name}]:-?}ms adds=${SHELL_FORTRESS_MODULE_ADDED_FUNCTIONS[${module_name}]:-0}fn/${SHELL_FORTRESS_MODULE_ADDED_ALIASES[${module_name}]:-0}alias requires=${${requires_text// /,}:-none}"
}

# Print the slowest enabled module and its load time.
# Arguments:
#   None.
# Returns:
#   0 after printing `<name> (<ms>ms)`, or none when no load times exist.
fortress-hud-slowest-module() {
  local module_name slowest_name=''
  local -F slowest_ms=-1

  for module_name in ${(k)SHELL_FORTRESS_MODULE_LOAD_MS}; do
    if (( SHELL_FORTRESS_MODULE_LOAD_MS[${module_name}] > slowest_ms )); then
      slowest_ms="${SHELL_FORTRESS_MODULE_LOAD_MS[${module_name}]}"
      slowest_name="${module_name}"
    fi
  done

  if [[ -z "${slowest_name}" ]]; then
    print -r -- 'none'
    return 0
  fi
  print -r -- "${slowest_name} (${SHELL_FORTRESS_MODULE_LOAD_MS[${slowest_name}]}ms)"
}

# Print the startup timing and warnings section.
# Arguments:
#   $1: renderer mode, standard or pretty.
# Returns:
#   0 after printing the section.
# Side effects:
#   Writes HUD lines to stdout. Pretty mode escapes % in warning text so
#   print -P does not treat paths as prompt sequences.
fortress-hud-print-startup() {
  local render_mode="$1"
  local stage_name warning_text warnings_value

  fortress-hud-section "${render_mode}" startup '󱎫' 'Startup'

  # Shells that did not start through the fortress .zshrc have no timing tables.
  if [[ "${(t)SHELL_FORTRESS_STARTUP_STAGE_MS}" != association* ]]; then
    fortress-hud-line "${render_mode}" startup 'zshrc_total' 'unrecorded'
    return 0
  fi

  fortress-hud-line "${render_mode}" startup 'zshrc_total' "${SHELL_FORTRESS_STARTUP_TOTAL_MS:-unknown}ms"
  for stage_name in "${SHELL_FORTRESS_STARTUP_STAGES[@]}"; do
    fortress-hud-line "${render_mode}" startup "${stage_name}" "${SHELL_FORTRESS_STARTUP_STAGE_MS[${stage_name}]:-?}ms"
  done
  fortress-hud-line "${render_mode}" startup 'slowest_module' "$(fortress-hud-slowest-module)"

  warnings_value="${#SHELL_FORTRESS_STARTUP_WARNINGS[@]}"
  if [[ "${render_mode}" == 'pretty' ]]; then
    if (( ${#SHELL_FORTRESS_STARTUP_WARNINGS[@]} )); then
      warnings_value="%F{221}${warnings_value}%f"
    else
      warnings_value="%F{114}${warnings_value}%f"
    fi
  fi
  fortress-hud-line "${render_mode}" startup 'warnings' "${warnings_value}"
  for warning_text in "${SHELL_FORTRESS_STARTUP_WARNINGS[@]}"; do
    [[ "${render_mode}" == 'pretty' ]] && warning_text="%F{221}${warning_text//\%/%%}%f"
    fortress-hud-line "${render_mode}" startup 'warning' "${warning_text}"
  done
}

# Print the current branch lifecycle summary when gbm is available.
# Arguments:
#   None.
# Returns:
#   0 after printing one compact summary line.
fortress-hud-branch-lifecycle-summary() {
  local current_branch=''
  local gbm_output=''
  local status_line=''
  local output_line=''

  (( $+commands[git] )) || { print -r -- 'git-missing'; return 0; }
  command git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { print -r -- 'not-in-repo'; return 0; }
  (( $+functions[gbm] )) || { print -r -- 'gbm-unavailable'; return 0; }

  current_branch="$(command git branch --show-current 2>/dev/null)"
  [[ -n "${current_branch}" ]] || { print -r -- 'detached'; return 0; }

  gbm_output="$(gbm status "${current_branch}" 2>/dev/null)" || { print -r -- "${current_branch} state=active"; return 0; }
  for output_line in ${(f)gbm_output}; do
    if [[ "${output_line}" == gbm\ status:\ * ]]; then
      status_line="${output_line#gbm status: }"
      break
    fi
  done
  [[ -n "${status_line}" ]] || status_line="active ${current_branch}"
  print -r -- "${current_branch} state=${status_line}"
}

# Print the resolved Brewfile when the curated brew module is loaded.
# Arguments:
#   None.
# Returns:
#   0 after printing one compact summary line.
fortress-hud-brewfile-summary() {
  local brewfile_path=''

  (( $+commands[brew] )) || { print -r -- 'brew-missing'; return 0; }
  (( $+functions[brew-file] )) || { print -r -- 'module-disabled'; return 0; }

  brewfile_path="$(brew-file 2>/dev/null)" || {
    print -r -- "missing HOMEBREW_BUNDLE_FILE=${HOMEBREW_BUNDLE_FILE:-unset}"
    return 0
  }
  print -r -- "${brewfile_path}"
}

# Print a renderer-aware section heading.
# Arguments:
#   $1: renderer mode, standard or pretty.
#   $2: section id.
#   $3: icon.
#   $4: title.
# Returns:
#   0 after printing the heading.
# Side effects:
#   Writes a section heading to stdout.
fortress-hud-section() {
  local render_mode="$1"
  local section_name="$2"
  local section_icon="$3"
  local section_title="$4"

  if [[ "${render_mode}" == 'pretty' ]]; then
    fortress-hud-print-pretty-heading "${section_icon}" "${section_title}"
  else
    print -r -- "[${section_name}]"
  fi
}

# Print a renderer-aware key/value line.
# Arguments:
#   $1: renderer mode, standard or pretty.
#   $2: section id.
#   $3: key name.
#   $4: value text.
# Returns:
#   0 after printing the line.
# Side effects:
#   Writes one HUD line to stdout.
fortress-hud-line() {
  local render_mode="$1"
  local section_name="$2"
  local key_name="$3"
  local value_text="$4"

  if [[ "${render_mode}" == 'pretty' ]]; then
    fortress-hud-print-pretty-line "${key_name}" "${value_text}"
  else
    fortress-hud-print-standard-line "${section_name}" "${key_name}" "${value_text}"
  fi
}

# Print a blank line between sections.
# Arguments:
#   None.
# Returns:
#   0 after printing a blank line.
# Side effects:
#   Writes a blank line to stdout.
fortress-hud-blank() {
  print -r -- ''
}

# Color one env-table cell for pretty mode.
# Arguments:
#   $1: column kind.
#   $2: raw cell value.
# Returns:
#   0 after printing the colored cell text.
# Side effects:
#   Writes a colorized table cell to stdout.
fortress-hud-color-env-cell() {
  local column_kind="$1"
  local raw_value="$2"

  case "${column_kind}" in
    resolved)
      case "${raw_value}" in
        on|1)
          print -P -- "%F{114}${raw_value}%f"
          ;;
        off|0)
          print -P -- "%F{203}${raw_value}%f"
          ;;
        *)
          print -r -- "${raw_value}"
          ;;
      esac
      ;;
    source)
      case "${raw_value}" in
        env)
          print -P -- "%F{117}${raw_value}%f"
          ;;
        persistent)
          print -P -- "%F{141}${raw_value}%f"
          ;;
        default)
          print -P -- "%F{244}${raw_value}%f"
          ;;
        *)
          print -r -- "${raw_value}"
          ;;
      esac
      ;;
    env_value|settings_value)
      case "${raw_value}" in
        unset)
          print -P -- "%F{244}${raw_value}%f"
          ;;
        1|true|yes|on)
          print -P -- "%F{114}${raw_value}%f"
          ;;
        0|false|no|off)
          print -P -- "%F{203}${raw_value}%f"
          ;;
        *)
          print -P -- "%F{221}${raw_value}%f"
          ;;
      esac
      ;;
    *)
      print -r -- "${raw_value}"
      ;;
  esac
}

# Print one standard-mode env-mapping row for a fortress setting.
# Arguments:
#   $1: logical setting name.
#   $2: env override variable name.
#   $3: persistent settings variable name.
#   $4: resolved value text.
#   $5: source label.
# Returns:
#   0 after printing the mapping.
# Side effects:
#   Reads raw shell parameters by name and writes one HUD line to stdout.
fortress-hud-env-line() {
  local setting_name="$1"
  local env_name="$2"
  local settings_name="$3"
  local env_raw_name="$4"
  local settings_raw_name="$5"
  local resolved_value="$6"
  local source_label="$7"
  local env_value="${(P)env_raw_name:-unset}"
  local settings_value="${(P)settings_raw_name:-unset}"

  fortress-hud-line \
    standard \
    env \
    "${setting_name}" \
    "env=${env_name}:${env_value} persistent=${settings_name}:${settings_value} resolved=${resolved_value} source=${source_label}"
}

# Print the pretty-mode env table.
# Arguments:
#   None.
# Returns:
#   0 after printing the env mapping table.
# Side effects:
#   Reads raw shell parameters by name and writes a formatted table to stdout.
fortress-hud-print-pretty-env-table() {
  local -a rows
  local row
  local setting_name env_name settings_name env_raw_name settings_raw_name resolved_value source_label env_value settings_value
  local setting_header='setting'
  local resolved_header='resolved'
  local source_header='source'
  local env_name_header='env var'
  local env_value_header='env value'
  local settings_name_header='settings var'
  local settings_value_header='settings value'
  local -i setting_width=${#setting_header}
  local -i resolved_width=${#resolved_header}
  local -i source_width=${#source_header}
  local -i env_name_width=${#env_name_header}
  local -i env_value_width=${#env_value_header}
  local -i settings_name_width=${#settings_name_header}
  local -i settings_value_width=${#settings_value_header}

  rows=(
    "native_git|SHELL_FORTRESS_ENABLE_NATIVE_GIT|SHELL_FORTRESS_SETTING_ENABLE_NATIVE_GIT|SHELL_FORTRESS_RAW_ENV_ENABLE_NATIVE_GIT|SHELL_FORTRESS_RAW_SETTING_ENABLE_NATIVE_GIT|${SHELL_FORTRESS_ENABLE_NATIVE_GIT:-unset}|${SHELL_FORTRESS_SOURCE_ENABLE_NATIVE_GIT:-default}"
    "zsh_vi_mode|SHELL_FORTRESS_ENABLE_ZSH_VI_MODE|SHELL_FORTRESS_SETTING_ENABLE_ZSH_VI_MODE|SHELL_FORTRESS_RAW_ENV_ENABLE_ZSH_VI_MODE|SHELL_FORTRESS_RAW_SETTING_ENABLE_ZSH_VI_MODE|${SHELL_FORTRESS_ENABLE_ZSH_VI_MODE:-unset}|${SHELL_FORTRESS_SOURCE_ENABLE_ZSH_VI_MODE:-default}"
    "zsh_autocomplete|SHELL_FORTRESS_ENABLE_ZSH_AUTOCOMPLETE|SHELL_FORTRESS_SETTING_ENABLE_ZSH_AUTOCOMPLETE|SHELL_FORTRESS_RAW_ENV_ENABLE_ZSH_AUTOCOMPLETE|SHELL_FORTRESS_RAW_SETTING_ENABLE_ZSH_AUTOCOMPLETE|${SHELL_FORTRESS_ENABLE_ZSH_AUTOCOMPLETE:-unset}|${SHELL_FORTRESS_SOURCE_ENABLE_ZSH_AUTOCOMPLETE:-default}"
    "zsh_autosuggestions|SHELL_FORTRESS_ENABLE_ZSH_AUTOSUGGESTIONS|SHELL_FORTRESS_SETTING_ENABLE_ZSH_AUTOSUGGESTIONS|SHELL_FORTRESS_RAW_ENV_ENABLE_ZSH_AUTOSUGGESTIONS|SHELL_FORTRESS_RAW_SETTING_ENABLE_ZSH_AUTOSUGGESTIONS|${SHELL_FORTRESS_ENABLE_ZSH_AUTOSUGGESTIONS:-unset}|${SHELL_FORTRESS_SOURCE_ENABLE_ZSH_AUTOSUGGESTIONS:-default}"
    "fzf_tab|SHELL_FORTRESS_ENABLE_FZF_TAB|SHELL_FORTRESS_SETTING_ENABLE_FZF_TAB|SHELL_FORTRESS_RAW_ENV_ENABLE_FZF_TAB|SHELL_FORTRESS_RAW_SETTING_ENABLE_FZF_TAB|${SHELL_FORTRESS_ENABLE_FZF_TAB:-unset}|${SHELL_FORTRESS_SOURCE_ENABLE_FZF_TAB:-default}"
    "atuin|SHELL_FORTRESS_ENABLE_ATUIN|SHELL_FORTRESS_SETTING_ENABLE_ATUIN|SHELL_FORTRESS_RAW_ENV_ENABLE_ATUIN|SHELL_FORTRESS_RAW_SETTING_ENABLE_ATUIN|${SHELL_FORTRESS_ENABLE_ATUIN:-unset}|${SHELL_FORTRESS_SOURCE_ENABLE_ATUIN:-default}"
    "histsize|HISTSIZE|SHELL_FORTRESS_SETTING_HISTSIZE|SHELL_FORTRESS_RAW_ENV_HISTSIZE|SHELL_FORTRESS_RAW_SETTING_HISTSIZE|${HISTSIZE:-unset}|${SHELL_FORTRESS_SOURCE_HISTSIZE:-default}"
    "savehist|SAVEHIST|SHELL_FORTRESS_SETTING_SAVEHIST|SHELL_FORTRESS_RAW_ENV_SAVEHIST|SHELL_FORTRESS_RAW_SETTING_SAVEHIST|${SAVEHIST:-unset}|${SHELL_FORTRESS_SOURCE_SAVEHIST:-default}"
    "keytimeout|KEYTIMEOUT|SHELL_FORTRESS_SETTING_KEYTIMEOUT|SHELL_FORTRESS_RAW_ENV_KEYTIMEOUT|SHELL_FORTRESS_RAW_SETTING_KEYTIMEOUT|${KEYTIMEOUT:-unset}|${SHELL_FORTRESS_SOURCE_KEYTIMEOUT:-default}"
    "prompt_engine|SHELL_FORTRESS_PROMPT_ENGINE|SHELL_FORTRESS_SETTING_PROMPT_ENGINE|SHELL_FORTRESS_RAW_ENV_PROMPT_ENGINE|SHELL_FORTRESS_RAW_SETTING_PROMPT_ENGINE|${SHELL_FORTRESS_ACTIVE_PROMPT_ENGINE:-unset}|${SHELL_FORTRESS_SOURCE_PROMPT_ENGINE:-default}"
    "editor|EDITOR|SHELL_FORTRESS_SETTING_EDITOR|SHELL_FORTRESS_RAW_ENV_EDITOR|SHELL_FORTRESS_RAW_SETTING_EDITOR|${EDITOR:-unset}|${SHELL_FORTRESS_SOURCE_EDITOR:-default}"
  )

  for row in "${rows[@]}"; do
    setting_name="${row%%|*}"
    row="${row#*|}"
    env_name="${row%%|*}"
    row="${row#*|}"
    settings_name="${row%%|*}"
    row="${row#*|}"
    env_raw_name="${row%%|*}"
    row="${row#*|}"
    settings_raw_name="${row%%|*}"
    row="${row#*|}"
    resolved_value="${row%%|*}"
    source_label="${row#*|}"
    env_value="${(P)env_raw_name:-unset}"
    settings_value="${(P)settings_raw_name:-unset}"

    (( ${#setting_name} > setting_width )) && setting_width=${#setting_name}
    (( ${#resolved_value} > resolved_width )) && resolved_width=${#resolved_value}
    (( ${#source_label} > source_width )) && source_width=${#source_label}
    (( ${#env_name} > env_name_width )) && env_name_width=${#env_name}
    (( ${#env_value} > env_value_width )) && env_value_width=${#env_value}
    (( ${#settings_name} > settings_name_width )) && settings_name_width=${#settings_name}
    (( ${#settings_value} > settings_value_width )) && settings_value_width=${#settings_value}
  done

  print -P -- "  %F{110}${(r:${setting_width}:: :)setting_header}%f  %F{110}${(r:${resolved_width}:: :)resolved_header}%f  %F{110}${(r:${source_width}:: :)source_header}%f  %F{110}${(r:${env_name_width}:: :)env_name_header}%f  %F{110}${(r:${env_value_width}:: :)env_value_header}%f  %F{110}${(r:${settings_name_width}:: :)settings_name_header}%f  %F{110}${(r:${settings_value_width}:: :)settings_value_header}%f"

  for row in "${rows[@]}"; do
    setting_name="${row%%|*}"
    row="${row#*|}"
    env_name="${row%%|*}"
    row="${row#*|}"
    settings_name="${row%%|*}"
    row="${row#*|}"
    env_raw_name="${row%%|*}"
    row="${row#*|}"
    settings_raw_name="${row%%|*}"
    row="${row#*|}"
    resolved_value="${row%%|*}"
    source_label="${row#*|}"
    env_value="${(P)env_raw_name:-unset}"
    settings_value="${(P)settings_raw_name:-unset}"

    printf '  %-*s  ' "${setting_width}" "${setting_name}"
    printf '%s' "$(fortress-hud-color-env-cell resolved "${resolved_value}")"
    printf '%*s  ' "$(( resolved_width - ${#resolved_value} ))" ''
    printf '%s' "$(fortress-hud-color-env-cell source "${source_label}")"
    printf '%*s  ' "$(( source_width - ${#source_label} ))" ''
    printf '%-*s  ' "${env_name_width}" "${env_name}"
    printf '%s' "$(fortress-hud-color-env-cell env_value "${env_value}")"
    printf '%*s  ' "$(( env_value_width - ${#env_value} ))" ''
    printf '%-*s  ' "${settings_name_width}" "${settings_name}"
    printf '%s' "$(fortress-hud-color-env-cell settings_value "${settings_value}")"
    printf '%*s\n' "$(( settings_value_width - ${#settings_value} ))" ''
  done
}

# Detect whether the current shell appears to be inside a container.
# Arguments:
#   None.
# Returns:
#   0 after printing yes or no.
# Side effects:
#   Reads common container marker files and environment variables.
fortress-hud-container-state() {
  if [[ -f /.dockerenv || -f /run/.containerenv || -n "${container:-}" ]]; then
    print -r -- 'yes'
  else
    print -r -- 'no'
  fi
}

# Print the two slowest startup stages for the human view.
# Arguments:
#   None.
# Returns:
#   0 after printing `<stage> <ms>ms, <stage> <ms>ms`, or nothing when no
#   timings were recorded.
fortress-hud-slowest-stages() {
  local stage_name ranked_entry
  local -a ranked labels

  [[ "${(t)SHELL_FORTRESS_STARTUP_STAGE_MS}" == association* ]] || return 0

  for stage_name in ${(k)SHELL_FORTRESS_STARTUP_STAGE_MS}; do
    ranked+=("${SHELL_FORTRESS_STARTUP_STAGE_MS[${stage_name}]}:${stage_name}")
  done
  ranked=("${(@On)ranked}")
  for ranked_entry in "${(@)ranked[1,2]}"; do
    labels+=("${ranked_entry#*:} ${ranked_entry%%:*}ms")
  done
  print -r -- "${(j:, :)labels}"
}

# Print enabled modules as one glyph-tagged line for the human view.
# Arguments:
#   None.
# Returns:
#   0 after printing the module list, or `none`.
# Side effects:
#   Emits prompt color sequences for print -P.
fortress-hud-human-modules() {
  local module_name module_status active_source source_note
  local -a module_cells

  for module_name in "${SHELL_FORTRESS_EFFECTIVE_MODULES[@]}"; do
    module_status="$(fortress-hud-module-status "${module_name}")"
    active_source="$(fortress-hud-module-active-source "${module_name}")"
    case "${active_source}" in
      local-fork) source_note=' (fork)' ;;
      local-only) source_note=' (local)' ;;
      *) source_note='' ;;
    esac
    case "${module_status}" in
      loaded) module_cells+=("%F{114}✓%f ${module_name}${source_note}") ;;
      skipped*) module_cells+=("%F{244}⊘ ${module_name}${source_note} ${module_status#skipped}%f") ;;
      *) module_cells+=("%F{203}✗ ${module_name}${source_note} ${module_status}%f") ;;
    esac
  done

  print -r -- "${(j:  :)module_cells:-none}"
}

# Print settings whose value did not come from the profile default.
# Arguments:
#   None.
# Returns:
#   0 after printing `name=value (source)` pairs, or `all defaults`.
fortress-hud-human-settings() {
  local row setting_name value_name source_name source_label value_text
  local -a rows changed

  rows=(
    "native_git:SHELL_FORTRESS_ENABLE_NATIVE_GIT:SHELL_FORTRESS_SOURCE_ENABLE_NATIVE_GIT"
    "zsh_vi_mode:SHELL_FORTRESS_ENABLE_ZSH_VI_MODE:SHELL_FORTRESS_SOURCE_ENABLE_ZSH_VI_MODE"
    "zsh_autocomplete:SHELL_FORTRESS_ENABLE_ZSH_AUTOCOMPLETE:SHELL_FORTRESS_SOURCE_ENABLE_ZSH_AUTOCOMPLETE"
    "zsh_autosuggestions:SHELL_FORTRESS_ENABLE_ZSH_AUTOSUGGESTIONS:SHELL_FORTRESS_SOURCE_ENABLE_ZSH_AUTOSUGGESTIONS"
    "fzf_tab:SHELL_FORTRESS_ENABLE_FZF_TAB:SHELL_FORTRESS_SOURCE_ENABLE_FZF_TAB"
    "atuin:SHELL_FORTRESS_ENABLE_ATUIN:SHELL_FORTRESS_SOURCE_ENABLE_ATUIN"
    "histsize:HISTSIZE:SHELL_FORTRESS_SOURCE_HISTSIZE"
    "savehist:SAVEHIST:SHELL_FORTRESS_SOURCE_SAVEHIST"
    "keytimeout:KEYTIMEOUT:SHELL_FORTRESS_SOURCE_KEYTIMEOUT"
    "prompt_engine:SHELL_FORTRESS_CONFIGURED_PROMPT_ENGINE:SHELL_FORTRESS_SOURCE_PROMPT_ENGINE"
    "editor:EDITOR:SHELL_FORTRESS_SOURCE_EDITOR"
  )

  for row in "${rows[@]}"; do
    setting_name="${row%%:*}"
    value_name="${${row#*:}%%:*}"
    source_name="${row##*:}"
    source_label="${(P)source_name:-default}"
    [[ "${source_label}" == 'default' ]] && continue
    value_text="${(P)value_name:-unset}"
    if [[ "${value_name}" == SHELL_FORTRESS_ENABLE_* ]]; then
      (( value_text )) && value_text='on' || value_text='off'
    fi
    changed+=("${setting_name}=${value_text} (${source_label})")
  done

  print -r -- "${(j:, :)changed:-all defaults}"
}

# Print the condensed human HUD: highlights and problems only.
# Arguments:
#   $1: runtime context label.
# Returns:
#   0 after printing the view.
# Side effects:
#   Writes Catppuccin-tinted lines to stdout. Escapes % in warning text and
#   paths so print -P does not treat them as prompt sequences.
fortress-hud-print-human() {
  local runtime_context="$1"
  local startup_text slowest_text warning_text branch_text branch_state brewfile_text tool_name
  local -a missing_tools

  fortress-hud-print-pretty-heading '󰒓' "${SHELL_PROFILE_NAME:-unknown}  %F{244}${runtime_context} · prompt ${SHELL_FORTRESS_ACTIVE_PROMPT_ENGINE:-unset}%f"

  if [[ -n "${SHELL_FORTRESS_STARTUP_TOTAL_MS:-}" ]]; then
    startup_text="${SHELL_FORTRESS_STARTUP_TOTAL_MS}ms"
    slowest_text="$(fortress-hud-slowest-stages)"
    [[ -n "${slowest_text}" ]] && startup_text+=" %F{244}(slowest: ${slowest_text})%f"
  else
    startup_text='unrecorded'
  fi
  fortress-hud-print-pretty-line '󱎫 startup' "${startup_text}"

  if (( ${#SHELL_FORTRESS_STARTUP_WARNINGS[@]} )); then
    fortress-hud-print-pretty-line ' warnings' "%F{221}${#SHELL_FORTRESS_STARTUP_WARNINGS[@]}%f"
    for warning_text in "${SHELL_FORTRESS_STARTUP_WARNINGS[@]}"; do
      print -P -- "    %F{221}• ${warning_text//\%/%%}%f"
    done
  else
    fortress-hud-print-pretty-line ' warnings' '%F{114}none%f'
  fi

  fortress-hud-print-pretty-line '󰈔 modules' "$(fortress-hud-human-modules)"
  fortress-hud-print-pretty-line '󰘳 settings' "$(fortress-hud-human-settings)"

  for tool_name in git fzf atuin starship eza zoxide direnv; do
    (( $+commands[${tool_name}] )) || missing_tools+=("${tool_name}")
  done
  if (( ${#missing_tools} )); then
    fortress-hud-print-pretty-line ' tools' "%F{221}not installed: ${(j:, :)missing_tools}%f"
  else
    fortress-hud-print-pretty-line ' tools' '%F{114}all present%f'
  fi

  branch_text="$(fortress-hud-branch-lifecycle-summary)"
  case "${branch_text}" in
    git-missing|not-in-repo|gbm-unavailable) ;;
    *)
      branch_state="${branch_text#* state=}"
      branch_text="${branch_text%% state=*}"
      fortress-hud-print-pretty-line ' branch' "${branch_text} %F{244}(${branch_state% ${branch_text}})%f"
      ;;
  esac

  if (( $+functions[brew-file] )); then
    brewfile_text="$(fortress-hud-brewfile-summary)"
    [[ "${brewfile_text}" == missing* ]] && brewfile_text="%F{203}${brewfile_text//\%/%%}%f" || brewfile_text="${brewfile_text//\%/%%}"
    fortress-hud-print-pretty-line ' brewfile' "${brewfile_text}"
  fi

  print -P -- '  %F{244}full detail: fortress-hud · fortress-hud --env · fortress-debug-interactive%f'
}

# Print the fortress HUD.
# Arguments:
#   $@ - Optional flags: --standard (full, plain; the default and the
#        agent-facing view), --pretty (full, styled), --human (condensed,
#        styled), and --env (adds env mapping to the full views).
# Returns:
#   0 after printing the HUD, non-zero on invalid arguments.
# Side effects:
#   Reads shell state, zle state, zstyles, command availability, recorded
#   startup diagnostics, and enabled module file headers.
fortress-hud() {
  autoload -Uz fortress-operator-binding-specs

  local render_mode='standard'
  local show_env_section=0
  local runtime_context='local'
  local keymap_value='unavailable'
  local active_tab_widget='unavailable'
  local compinit_loaded=0
  local zinit_loaded=0
  local fzf_tab_loaded=0
  local autocomplete_loaded=0
  local autosuggestions_loaded=0
  local zvm_loaded=0
  local atuin_initialized=0
  local current_line
  local source_label
  local value_label
  local local_modules_value='none'
  local operator_shortcuts_value=''
  local settings_file_exists=0
  local zinit_repo_ready=0
  local arg
  local key_sequence display_text widget_name action_text note_text
  local module_name module_summary_text

  for arg in "$@"; do
    case "${arg}" in
      --standard)
        render_mode='standard'
        ;;
      --pretty)
        render_mode='pretty'
        ;;
      --human)
        render_mode='human'
        ;;
      --env)
        show_env_section=1
        ;;
      *)
        print -u2 -- "fortress-hud: unknown argument: ${arg}"
        print -u2 -- 'usage: fortress-hud [--standard|--pretty|--human] [--env]'
        return 1
        ;;
    esac
  done

  if [[ "${render_mode}" == 'human' ]] && (( show_env_section )); then
    print -u2 -- 'fortress-hud: --env needs a full view; use --standard or --pretty'
    return 1
  fi

  if [[ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}" ]]; then
    runtime_context='ssh'
  fi

  if [[ -n "${TMUX:-}" ]]; then
    runtime_context="${runtime_context}+tmux"
  fi

  if [[ -o login ]]; then
    runtime_context="${runtime_context}+login"
  fi

  if [[ -o interactive ]]; then
    runtime_context="${runtime_context}+interactive"
  fi

  if [[ "${render_mode}" == 'human' ]]; then
    fortress-hud-print-human "${runtime_context}"
    return 0
  fi

  if (( ${#SHELL_FORTRESS_EFFECTIVE_MODULES[@]:-0} )); then
    local_modules_value="${(j:, :)SHELL_FORTRESS_EFFECTIVE_MODULES}"
  fi

  if [[ -n "${KEYMAP:-}" ]]; then
    keymap_value="${KEYMAP}"
  fi

  if (( $+functions[compinit] )); then
    compinit_loaded=1
  fi

  while IFS=$'\t' read -r key_sequence display_text widget_name action_text note_text; do
    if [[ -n "${operator_shortcuts_value}" ]]; then
      operator_shortcuts_value+=", "
    fi
    operator_shortcuts_value+="${key_sequence} ${action_text}"
  done < <(fortress-operator-binding-specs)

  if (( $+functions[zinit] )); then
    zinit_loaded=1
  fi
  if (( $+functions[_ftb__main_complete] || $+functions[enable-fzf-tab] )); then
    fzf_tab_loaded=1
  fi
  if (( $+functions[.autocomplete__main] || SHELL_FORTRESS_LOAD_ZSH_AUTOCOMPLETE )); then
    autocomplete_loaded=1
  fi
  if (( $+functions[_zsh_autosuggest_start] )); then
    autosuggestions_loaded=1
  fi
  if (( $+functions[zvm_widget_wrapper] )); then
    zvm_loaded=1
  fi
  if (( SHELL_FORTRESS_ENABLE_ATUIN )) && (( $+commands[atuin] )); then
    if (( $+functions[zvm_widget_wrapper] )); then
      if (( ${+zvm_after_init_commands} )); then
        atuin_initialized=1
      fi
    elif [[ -n "${ATUIN_CONFIG_DIR:-}" ]]; then
      atuin_initialized=1
    fi
  fi

  if [[ -r "${SHELL_FORTRESS_SETTINGS_FILE:-}" ]]; then
    settings_file_exists=1
  fi
  if [[ -r "${SHELL_PROFILE_ZINIT_HOME:-}/zinit.zsh" ]]; then
    zinit_repo_ready=1
  fi

  if zle -la >/dev/null 2>&1; then
    if (( ${${(f)"$(zle -la)"}[(I)fzf-tab-complete]} > 0 )); then
      active_tab_widget='fzf-tab-complete'
    else
      current_line="$(bindkey '^I' 2>/dev/null)"
      if [[ -n "${current_line}" ]]; then
        active_tab_widget="${current_line##* }"
      fi
    fi
  else
    current_line="$(bindkey '^I' 2>/dev/null || true)"
    if [[ -n "${current_line}" ]]; then
      active_tab_widget="${current_line##* }"
    fi
  fi

  fortress-hud-section "${render_mode}" profile '󰒓' 'Profile'
  fortress-hud-line "${render_mode}" profile 'name' "${SHELL_PROFILE_NAME:-unknown}"
  fortress-hud-line "${render_mode}" profile 'description' "${SHELL_PROFILE_DESCRIPTION:-unset}"
  fortress-hud-line "${render_mode}" profile 'zdotdir' "${ZDOTDIR:-unset}"
  fortress-hud-line "${render_mode}" profile 'runtime_context' "${runtime_context}"
  fortress-hud-line "${render_mode}" profile 'container' "$(fortress-hud-container-state)"
  fortress-hud-line "${render_mode}" profile 'keymap' "${keymap_value}"
  fortress-hud-blank

  fortress-hud-print-startup "${render_mode}"
  fortress-hud-blank

  fortress-hud-section "${render_mode}" settings '󰘳' 'Settings'
  fortress-hud-line "${render_mode}" settings 'settings_file' "${SHELL_FORTRESS_SETTINGS_FILE:-unset}"
  fortress-hud-line "${render_mode}" settings 'settings_file_exists' "$(fortress-hud-render-bool "${render_mode}" "${settings_file_exists}")"
  fortress-hud-line "${render_mode}" settings 'settings_template' "${SHELL_FORTRESS_SETTINGS_TEMPLATE:-unset}"
  fortress-hud-line "${render_mode}" settings 'prompt_engine_configured' "${SHELL_FORTRESS_CONFIGURED_PROMPT_ENGINE:-unset} (source=${SHELL_FORTRESS_SOURCE_PROMPT_ENGINE:-default})"
  fortress-hud-line "${render_mode}" settings 'prompt_engine_resolved' "${SHELL_FORTRESS_ACTIVE_PROMPT_ENGINE:-unset}"
  fortress-hud-line "${render_mode}" settings 'editor' "${EDITOR:-unset} (source=${SHELL_FORTRESS_SOURCE_EDITOR:-default})"

  source_label="${SHELL_FORTRESS_SOURCE_ENABLE_NATIVE_GIT:-default}"
  value_label="$(fortress-hud-render-bool "${render_mode}" "${SHELL_FORTRESS_ENABLE_NATIVE_GIT:-0}")"
  fortress-hud-line "${render_mode}" settings 'native_git' "${value_label} (source=${source_label})"

  source_label="${SHELL_FORTRESS_SOURCE_ENABLE_ZSH_VI_MODE:-default}"
  value_label="$(fortress-hud-render-bool "${render_mode}" "${SHELL_FORTRESS_ENABLE_ZSH_VI_MODE:-0}")"
  fortress-hud-line "${render_mode}" settings 'zsh_vi_mode' "${value_label} (source=${source_label})"

  source_label="${SHELL_FORTRESS_SOURCE_ENABLE_ZSH_AUTOCOMPLETE:-default}"
  value_label="$(fortress-hud-render-bool "${render_mode}" "${SHELL_FORTRESS_ENABLE_ZSH_AUTOCOMPLETE:-0}")"
  fortress-hud-line "${render_mode}" settings 'zsh_autocomplete' "${value_label} (source=${source_label})"

  source_label="${SHELL_FORTRESS_SOURCE_ENABLE_ZSH_AUTOSUGGESTIONS:-default}"
  value_label="$(fortress-hud-render-bool "${render_mode}" "${SHELL_FORTRESS_ENABLE_ZSH_AUTOSUGGESTIONS:-0}")"
  fortress-hud-line "${render_mode}" settings 'zsh_autosuggestions' "${value_label} (source=${source_label})"

  source_label="${SHELL_FORTRESS_SOURCE_ENABLE_FZF_TAB:-default}"
  value_label="$(fortress-hud-render-bool "${render_mode}" "${SHELL_FORTRESS_ENABLE_FZF_TAB:-0}")"
  fortress-hud-line "${render_mode}" settings 'fzf_tab' "${value_label} (source=${source_label})"

  source_label="${SHELL_FORTRESS_SOURCE_ENABLE_ATUIN:-default}"
  value_label="$(fortress-hud-render-bool "${render_mode}" "${SHELL_FORTRESS_ENABLE_ATUIN:-0}")"
  fortress-hud-line "${render_mode}" settings 'atuin' "${value_label} (source=${source_label})"

  source_label="${SHELL_FORTRESS_SOURCE_HISTSIZE:-default}"
  fortress-hud-line "${render_mode}" settings 'histsize' "${HISTSIZE:-unset} (source=${source_label})"
  source_label="${SHELL_FORTRESS_SOURCE_SAVEHIST:-default}"
  fortress-hud-line "${render_mode}" settings 'savehist' "${SAVEHIST:-unset} (source=${source_label})"
  source_label="${SHELL_FORTRESS_SOURCE_KEYTIMEOUT:-default}"
  fortress-hud-line "${render_mode}" settings 'keytimeout' "${KEYTIMEOUT:-unset} (source=${source_label})"
  fortress-hud-blank

  fortress-hud-section "${render_mode}" features '󰆍' 'Features'
  fortress-hud-line "${render_mode}" features 'vi_autocomplete_compat' "$(fortress-hud-render-bool "${render_mode}" "${SHELL_FORTRESS_ENABLE_ZSH_VI_AUTOCOMPLETE_COMPAT:-0}")"
  fortress-hud-line "${render_mode}" features 'autocomplete_loaded' "$(fortress-hud-render-bool "${render_mode}" "${SHELL_FORTRESS_LOAD_ZSH_AUTOCOMPLETE:-0}")"
  fortress-hud-line "${render_mode}" features 'prompt_mode' "${SHELL_PROMPT_MODE:-unset}"
  fortress-hud-line "${render_mode}" features 'enabled_modules' "${local_modules_value}"
  fortress-hud-line "${render_mode}" features 'default_modules' "${(j:, :)SHELL_FORTRESS_DEFAULT_MODULES}"
  fortress-hud-line "${render_mode}" features 'disabled_modules' "${(j:, :)SHELL_FORTRESS_DISABLED_MODULES}"
  fortress-hud-line "${render_mode}" features 'atuin_config_dir' "${ATUIN_CONFIG_DIR:-unset}"
  fortress-hud-line "${render_mode}" features 'atuin_theme_dir' "${ATUIN_THEME_DIR:-unset}"
  fortress-hud-line "${render_mode}" features 'glamour_style' "${GLAMOUR_STYLE:-unset}"
  fortress-hud-blank

  fortress-hud-section "${render_mode}" module_resolution '󰈔' 'Module Resolution'
  fortress-hud-line "${render_mode}" module_resolution 'enabled_count' "${#SHELL_FORTRESS_EFFECTIVE_MODULES[@]:-0}"
  if (( ${#SHELL_FORTRESS_EFFECTIVE_MODULES[@]:-0} )); then
    for module_name in "${SHELL_FORTRESS_EFFECTIVE_MODULES[@]}"; do
      module_summary_text="$(fortress-hud-module-summary "${module_name}")"
      fortress-hud-line "${render_mode}" module_resolution "${module_name}" "${module_summary_text}"
    done
  else
    fortress-hud-line "${render_mode}" module_resolution 'modules' 'none'
  fi
  fortress-hud-blank

  fortress-hud-section "${render_mode}" tools '󰈔' 'Tools'
  fortress-hud-line "${render_mode}" tools 'git' "$(fortress-hud-render-command "${render_mode}" git)"
  fortress-hud-line "${render_mode}" tools 'branch_lifecycle' "$(fortress-hud-branch-lifecycle-summary)"
  fortress-hud-line "${render_mode}" tools 'zinit_repo' "$(fortress-hud-render-bool "${render_mode}" "${zinit_repo_ready}")"
  fortress-hud-line "${render_mode}" tools 'fzf' "$(fortress-hud-render-command "${render_mode}" fzf)"
  fortress-hud-line "${render_mode}" tools 'atuin' "$(fortress-hud-render-command "${render_mode}" atuin)"
  fortress-hud-line "${render_mode}" tools 'starship' "$(fortress-hud-render-command "${render_mode}" starship)"
  fortress-hud-line "${render_mode}" tools 'eza' "$(fortress-hud-render-command "${render_mode}" eza)"
  fortress-hud-line "${render_mode}" tools 'zoxide' "$(fortress-hud-render-command "${render_mode}" zoxide)"
  fortress-hud-line "${render_mode}" tools 'direnv' "$(fortress-hud-render-command "${render_mode}" direnv)"
  fortress-hud-line "${render_mode}" tools 'brew' "$(fortress-hud-render-command "${render_mode}" brew)"
  fortress-hud-line "${render_mode}" tools 'brewfile' "$(fortress-hud-brewfile-summary)"
  fortress-hud-blank

  fortress-hud-section "${render_mode}" runtime '󰌌' 'Runtime'
  fortress-hud-line "${render_mode}" runtime 'zinit_loaded' "$(fortress-hud-render-bool "${render_mode}" "${zinit_loaded}")"
  fortress-hud-line "${render_mode}" runtime 'compinit_loaded' "$(fortress-hud-render-bool "${render_mode}" "${compinit_loaded}")"
  fortress-hud-line "${render_mode}" runtime 'fzf_tab_loaded' "$(fortress-hud-render-bool "${render_mode}" "${fzf_tab_loaded}")"
  fortress-hud-line "${render_mode}" runtime 'autocomplete_functions' "$(fortress-hud-render-bool "${render_mode}" "${autocomplete_loaded}")"
  fortress-hud-line "${render_mode}" runtime 'autosuggestions_loaded' "$(fortress-hud-render-bool "${render_mode}" "${autosuggestions_loaded}")"
  fortress-hud-line "${render_mode}" runtime 'zsh_vi_mode_loaded' "$(fortress-hud-render-bool "${render_mode}" "${zvm_loaded}")"
  fortress-hud-line "${render_mode}" runtime 'atuin_initialized' "$(fortress-hud-render-bool "${render_mode}" "${atuin_initialized}")"
  fortress-hud-line "${render_mode}" runtime 'active_tab_widget' "${active_tab_widget}"
  fortress-hud-line "${render_mode}" runtime 'operator_prefix' 'Ctrl-G'
  fortress-hud-line "${render_mode}" runtime 'operator_shortcuts' "${operator_shortcuts_value}"
  fortress-hud-blank

  fortress-hud-section "${render_mode}" paths '󰉋' 'Paths'
  fortress-hud-line "${render_mode}" paths 'history_file' "${HISTFILE:-unset}"
  fortress-hud-line "${render_mode}" paths 'state_dir' "${SHELL_PROFILE_STATE_DIR:-unset}"
  fortress-hud-line "${render_mode}" paths 'cache_dir' "${SHELL_PROFILE_CACHE_DIR:-unset}"
  fortress-hud-line "${render_mode}" paths 'data_dir' "${SHELL_PROFILE_DATA_DIR:-unset}"
  fortress-hud-line "${render_mode}" paths 'runtime_dir' "${SHELL_PROFILE_RUNTIME_DIR:-unset}"
  fortress-hud-line "${render_mode}" paths 'user_config_dir' "${SHELL_FORTRESS_USER_CONFIG_DIR:-unset}"
  fortress-hud-line "${render_mode}" paths 'env_file' "${SHELL_FORTRESS_ENV_FILE:-unset}"
  fortress-hud-line "${render_mode}" paths 'aliases_file' "${SHELL_FORTRESS_ALIASES_FILE:-unset}"
  fortress-hud-line "${render_mode}" paths 'functions_dir' "${SHELL_FORTRESS_FUNCTIONS_DIR:-unset}"
  fortress-hud-line "${render_mode}" paths 'modules_dir' "${SHELL_FORTRESS_MODULES_DIR:-unset}"
  fortress-hud-line "${render_mode}" paths 'zinit_root' "${SHELL_PROFILE_ZINIT_ROOT:-unset}"
  fortress-hud-line "${render_mode}" paths 'zinit_home' "${SHELL_PROFILE_ZINIT_HOME:-unset}"

  if (( show_env_section )); then
    fortress-hud-blank
    fortress-hud-section "${render_mode}" env '󰮂' 'Env Mapping'
    fortress-hud-line "${render_mode}" env 'settings_file' "${SHELL_FORTRESS_SETTINGS_FILE:-unset}"
    if [[ "${render_mode}" == 'pretty' ]]; then
      fortress-hud-print-pretty-env-table
    else
      fortress-hud-env-line 'native_git' 'SHELL_FORTRESS_ENABLE_NATIVE_GIT' 'SHELL_FORTRESS_SETTING_ENABLE_NATIVE_GIT' 'SHELL_FORTRESS_RAW_ENV_ENABLE_NATIVE_GIT' 'SHELL_FORTRESS_RAW_SETTING_ENABLE_NATIVE_GIT' "${SHELL_FORTRESS_ENABLE_NATIVE_GIT:-unset}" "${SHELL_FORTRESS_SOURCE_ENABLE_NATIVE_GIT:-default}"
      fortress-hud-env-line 'zsh_vi_mode' 'SHELL_FORTRESS_ENABLE_ZSH_VI_MODE' 'SHELL_FORTRESS_SETTING_ENABLE_ZSH_VI_MODE' 'SHELL_FORTRESS_RAW_ENV_ENABLE_ZSH_VI_MODE' 'SHELL_FORTRESS_RAW_SETTING_ENABLE_ZSH_VI_MODE' "${SHELL_FORTRESS_ENABLE_ZSH_VI_MODE:-unset}" "${SHELL_FORTRESS_SOURCE_ENABLE_ZSH_VI_MODE:-default}"
      fortress-hud-env-line 'zsh_autocomplete' 'SHELL_FORTRESS_ENABLE_ZSH_AUTOCOMPLETE' 'SHELL_FORTRESS_SETTING_ENABLE_ZSH_AUTOCOMPLETE' 'SHELL_FORTRESS_RAW_ENV_ENABLE_ZSH_AUTOCOMPLETE' 'SHELL_FORTRESS_RAW_SETTING_ENABLE_ZSH_AUTOCOMPLETE' "${SHELL_FORTRESS_ENABLE_ZSH_AUTOCOMPLETE:-unset}" "${SHELL_FORTRESS_SOURCE_ENABLE_ZSH_AUTOCOMPLETE:-default}"
