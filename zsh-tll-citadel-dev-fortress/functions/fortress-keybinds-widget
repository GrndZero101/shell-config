# Launch the fortress keybinding cheat sheet from zle.
#
# Arguments:
#   None.
# Returns:
#   0 after queuing the cheat-sheet command, non-zero when the current buffer is not empty.
# Side effects:
#   Executes `fortress-keybinds` through the active command line.
fortress-keybinds-widget() {
  emulate -L zsh

  fortress-zle-run-command 'fortress-keybinds'
}
